# Copy this file to .env and replace the placeholder. Script parameters and process
# environment variables take precedence over values in .env.
POWER_PLATFORM_DEV_ENVIRONMENT_URL=https://your-dev-environment.crm.dynamics.com/
# Used only for manual live tests against TypeSafe; never commit a real key.
TYPESAFE_API_KEY=your-typesafe-api-key-here

# Used for manual live tests and by the Microsoft-Decision-1 MCP server (mcp/microsoft-decision),
# which reads the process environment, then .env in its working directory, then ~/.env, then the
# OS credential store. For the MCP server, keep the key in the credential store instead of here:
#   uvx keyring set microsoft-decision-mcp MS_FOUNDRY_DECISION_1_API_KEY
# Never commit a real key.
MS_FOUNDRY_DECISION_1_ENDPOINT=https://your-resource.services.ai.azure.com/providers/microsoft/v1/systemone
MS_FOUNDRY_DECISION_1_DEPLOYMENT=Decision-1
MS_FOUNDRY_DECISION_1_API_KEY=your-foundry-api-key-here
